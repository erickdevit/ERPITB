{
  "name": "erpitb-worker",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "npm --prefix ../web run build",
    "dev": "npm --prefix ../web run dev:real",
    "dev:real": "npm run dev",
    "dev:local": "npm run build:web && wrangler dev --local --ip 127.0.0.1 --port 8787",
    "deploy": "npm run build:web && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "jose": "6.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260815.1",
    "@types/node": "^26.1.1",
    "typescript": "5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "4.123.0"
  }
}
