# ==============================================================================
# ERPITB — Configurações de Ambiente (Docker & Produção)
# ==============================================================================

# Porta da aplicação web + API
PORT=3000

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=erpitb_secret_pass
POSTGRES_DB=erpitb
POSTGRES_PORT=5432

# URL de Conexão com o PostgreSQL (para uso fora do docker compose)
# DATABASE_URL=postgres://postgres:erpitb_secret_pass@127.0.0.1:5432/erpitb

# Segredos de Segurança e Criptografia (LGPD)
# JWT_SECRET: Mínimo 32 caracteres para assinatura HS256
JWT_SECRET=erpitb-super-secret-jwt-key-minimum-32-chars-long

# DATA_ENCRYPTION_KEY: Chave de 32 bytes em Base64 (44 caracteres) ou 32 caracteres UTF-8
DATA_ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=

# BOOTSTRAP_SECRET: Segredo para criação do primeiro usuário administrador
BOOTSTRAP_SECRET=troque-este-segredo

# CORS / Origens Permitidas
ALLOWED_ORIGIN=*

# Timezone da Instituição
INSTITUTION_TIMEZONE=America/Sao_Paulo

# Caminho do Storage Local de Arquivos/Assets
STORAGE_PATH=/app/storage
